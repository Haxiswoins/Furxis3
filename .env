
# This is a template for your local environment variables.
# For deployment, create a `.env.local` file and fill in your actual keys.
# IMPORTANT: The `.env.local` file should NOT be committed to your Git repository.

# The public URL of your deployed website.
# Required for generating correct image URLs and other absolute links in production.
# Example: https://www.yourdomain.com or http://YOUR_SERVER_IP:3000
NEXT_PUBLIC_BASE_URL=

# --- Resend API Key (for email notifications) ---
# See RESEND_GUIDE.md for detailed instructions.
RESEND_API_KEY=

# --- Authing Application Config (for user authentication) ---
# You can find these values in your Authing console under your application's settings.
AUTHING_APP_ID=
AUTHING_APP_SECRET=
# Issuer URL, typically in the format: https://<YOUR-SUBDOMAIN>.authing.cn
AUTHING_ISSUER=

# Login Redirect Callback URL. This MUST exactly match the URL in your Authing app settings.
# For local development: http://localhost:3000/api/auth/authing/callback
# For production: https://<your-domain>/api/auth/authing/callback
AUTHING_REDIRECT_URI="http://localhost:3000/api/auth/authing/callback"

# A strong, random secret key for encrypting sessions.
# Generate one using: openssl rand -base64 32
AUTHING_SECRET=

# The email address of the site administrator.
# The user with this email will automatically gain admin privileges upon login.
ADMIN_EMAIL=

# --- Image Hosting API Token (Optional) ---
# Your Bearer Token for the image hosting service (cdn.markjoker.top).
# If you leave this blank, images will be uploaded as a guest.
NEXT_PUBLIC_IMAGE_HOSTING_TOKEN=
