
# 网站基础URL (例如: https://www.yourdomain.com)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Resend API Key (用于邮件通知)
# 详细配置请参考 RESEND_GUIDE.md
RESEND_API_KEY=re_...

# Authing 应用配置 (用于用户认证)
# 详细配置请参考 DEPLOY_GUIDE.md
AUTHING_APP_ID=68a539bd60ad89fcaeb3585f
AUTHING_APP_SECRET=750fdd113a91158818471993b3f46a6a
AUTHING_ISSUER=https://icwh5jsh38rx-demo.authing.cn
AUTHING_REDIRECT_URI=http://localhost:3000/api/auth/authing/callback

# 用于加密会话的密钥, 必须是一个至少32位的复杂随机字符串
# 可以使用 `openssl rand -base64 32` 命令生成
AUTHING_SECRET=a-very-secure-secret-you-must-change

# 管理员邮箱地址
# 这个邮箱的用户登录后将自动获得管理员权限
ADMIN_EMAIL=your-admin-email@example.com