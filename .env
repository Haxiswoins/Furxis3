
# 网站基础URL (例如: https://www.yourdomain.com)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Resend API Key (用于邮件通知)
# 详细配置请参考 RESEND_GUIDE.md
RESEND_API_KEY=""

# Authing 应用配置 (用于用户认证)
# 详细配置请参考 DEPLOY_GUIDE.md
AUTHING_APP_ID=""
AUTHING_APP_SECRET=""
AUTHING_ISSUER=""
AUTHING_REDIRECT_URI=""

# 用于加密会话的密钥, 必须是一个至少32位的复杂随机字符串
# 可以使用 `openssl rand -base64 32` 命令生成
AUTHING_SECRET=""

# 管理员邮箱地址
# 这个邮箱的用户登录后将自动获得管理员权限
ADMIN_EMAIL=""
