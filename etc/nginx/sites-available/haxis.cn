# ----------------------------------------------------
# HTTP (Port 80) to HTTPS (Port 443) Redirection
# ----------------------------------------------------
# 这个 server 块会捕获所有通过 http:// 访问的请求
# 并将它们永久重定向到 https://
server {
    listen 80;
    server_name haxis.cn; # 您的域名

    # 将所有请求重定向到 HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}

# ----------------------------------------------------
# HTTPS (Port 443) Server Configuration
# ----------------------------------------------------
# 这是处理您网站实际流量的核心配置
server {
    # 监听 443 端口并启用 SSL/TLS
    listen 443 ssl;
    server_name haxis.cn; # 您的域名

    # --- 证书路径配置 ---
    # 指向您之前上传的 SSL 证书文件
    ssl_certificate /root/ssl/haxis.cn.crt;
    ssl_certificate_key /root/ssl/haxis.cn.key;

    # --- SSL 性能与安全优化 ---
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers 'ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384';
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    # --- 反向代理到您的 Next.js 应用 ---
    # 所有经过 HTTPS 访问的请求都将被转发到这里
    location / {
        proxy_pass http://localhost:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
