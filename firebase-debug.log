[debug] [2025-08-15T07:24:12.873Z] >>> [apiv2][body] PUT http://127.0.0.1:8080/emulator/v1/projects/demo-app:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"\nrules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    // Helper functions\n    function isSignedIn() {\n      return request.auth != null;\n    }\n\n    function isOwner(userId) {\n      return request.auth.uid == userId;\n    }\n\n    function isAdmin() {\n      // In a real app, use custom claims for roles.\n      // For this project, we hardcode the admin's email.\n      return request.auth.token.email == 'haxiswoins@qq.com';\n    }\n\n    // Publicly readable collections\n    match /{collectionName}/{docId}\n    where collectionName in ['characters', 'characterSeries', 'commissionOptions', 'commissionStyles', 'works', 'site'] {\n      allow read: if true;\n      allow write: if isAdmin(); // Only admin can write\n    }\n\n    // Orders can only be read by their owner or an admin.\n    // New orders can be created by any signed-in user.\n    match /orders/{orderId} {\n      allow read, update: if isSignedIn() && (isOwner(resource.data.userId) || isAdmin());\n      allow create: if isSignedIn();\n      allow delete: if isAdmin();\n    }\n  }\n}\n"}]}}
