[debug] [2025-08-15T07:44:15.451Z] >>> [apiv2][body] PUT http://127.0.0.1:8080/emulator/v1/projects/demo-app:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"rules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n  \n    // Helper function to check for Admin role based on UID\n    function isAdmin() {\n      // Replace with the actual UID of your admin account in the new project.\n      // You can find the UID in the Firebase Console -> Authentication -> Users tab.\n      return request.auth.uid == \"PLEASE_UPDATE_WITH_YOUR_ADMIN_UID\";\n    }\n\n    // Site content is public readable, admin writable\n    match /site/{document} {\n      allow read: if true;\n      allow write: if isAdmin();\n    }\n    \n    // Characters and related content are public readable, admin writable\n    match /characterSeries/{seriesId} {\n      allow read: if true;\n      allow write: if isAdmin();\n    }\n    \n    match /characters/{characterId} {\n      allow read: if true;\n      allow write: if isAdmin();\n    }\n    \n    // Commissions and related content are public readable, admin writable\n    match /commissionOptions/{optionId} {\n      allow read: if true;\n      allow write: if isAdmin();\n    }\n    \n    match /commissionStyles/{styleId} {\n      allow read: if true;\n      allow write: if isAdmin();\n    }\n\n    // Works are public readable, admin writable\n    match /works/{workId} {\n        allow read: if true;\n        allow write: if isAdmin();\n    }\n\n    // Orders can only be read by the user who owns it or an admin.\n    // Only admins can create, update, or delete orders.\n    match /orders/{orderId} {\n      allow read: if request.auth.uid == resource.data.userId || isAdmin();\n      allow create, update, delete: if isAdmin();\n    }\n  }\n}\n"}]}}
