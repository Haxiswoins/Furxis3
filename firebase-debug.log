[debug] [2025-08-15T08:19:08.573Z] >>> [apiv2][body] PUT http://127.0.0.1:8080/emulator/v1/projects/demo-app:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"\nrules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    // Helper function to check if the user is the designated admin\n    function isAdmin() {\n      return request.auth.uid == 's4uext3URcWMry52mRcPSeMhl0H2';\n    }\n\n    // Helper function to check if the user is the owner of the document\n    function isOwner(userId) {\n      return request.auth.uid == userId;\n    }\n\n    // Publicly readable collections, only writable by admin\n    match /characters/{characterId} {\n      allow read: if true;\n      allow write: if isAdmin();\n    }\n\n    match /characterSeries/{seriesId} {\n      allow read: if true;\n      allow write: if isAdmin();\n    }\n\n    match /commissionOptions/{optionId} {\n      allow read: if true;\n      allow write: if isAdmin();\n    }\n\n    match /commissionStyles/{styleId} {\n      allow read: if true;\n      allow write: if isAdmin();\n    }\n    \n    match /works/{workId} {\n      allow read: if true;\n      allow write: if isAdmin();\n    }\n\n    // Site content is publicly readable, only writable by admin\n    match /site/content {\n      allow read: if true;\n      allow write: if isAdmin();\n    }\n\n    // Orders can be created by any authenticated user.\n    // They can only be read or updated by the owner or an admin.\n    // Deletion is restricted to admin only.\n    match /orders/{orderId} {\n      allow create: if request.auth != null;\n      allow read, update: if isOwner(resource.data.userId) || isAdmin();\n      allow delete: if isAdmin();\n    }\n  }\n}\n"}]}}
