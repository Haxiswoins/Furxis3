[debug] [2025-08-15T08:06:15.393Z] >>> [apiv2][body] PUT http://127.0.0.1:8080/emulator/v1/projects/demo-app:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"rules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    // Helper function to check if a user is the designated admin\n    function isAdmin(userId) {\n      return userId == \"s4uext3URcWMry52mRcPSeMhl0H2\";\n    }\n\n    // Helper function to check if a user is the owner of a document\n    function isOwner(userId) {\n      return request.auth.uid == userId;\n    }\n    \n    // Characters: Publicly readable, admin only write access\n    match /characters/{characterId} {\n      allow read: if true;\n      allow write: if isAdmin(request.auth.uid);\n    }\n    \n    // Character Series: Publicly readable, admin only write access\n    match /characterSeries/{seriesId} {\n        allow read: if true;\n        allow write: if isAdmin(request.auth.uid);\n    }\n\n    // Commission Options: Publicly readable, admin only write access\n    match /commissionOptions/{optionId} {\n      allow read: if true;\n      allow write: if isAdmin(request.auth.uid);\n    }\n    \n    // Commission Styles: Publicly readable, admin only write access\n    match /commissionStyles/{styleId} {\n        allow read: if true;\n        allow write: if isAdmin(request.auth.uid);\n    }\n    \n    // Works: Publicly readable, admin only write access\n    match /works/{workId} {\n        allow read: if true;\n        allow write: if isAdmin(request.auth.uid);\n    }\n\n    // Site Content: Publicly readable, admin only write access\n    match /site/content {\n      allow read: if true;\n      allow write: if isAdmin(request.auth.uid);\n    }\n\n    // Orders: Users can read their own orders, admins can read all.\n    // Users can create orders. Admins can update/delete any order.\n    // Users can only update their own order if they are the owner.\n    match /orders/{orderId} {\n      allow read, update: if isOwner(resource.data.userId) || isAdmin(request.auth.uid);\n      allow create: if request.auth != null; // Any authenticated user can create an order\n      allow delete: if isAdmin(request.auth.uid);\n    }\n  }\n}\n"}]}}
