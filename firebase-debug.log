[debug] [2025-08-15T07:47:33.712Z] >>> [apiv2][body] PUT http://127.0.0.1:8080/emulator/v1/projects/demo-app:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"\nrules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    // Helper function to check if the user is an admin\n    function isAdmin() {\n      return request.auth != null && request.auth.uid == 'jH8oPmt3a3bX7yGjZ2kC5sFvWqE2';\n    }\n\n    // Site content: Publicly readable, admin writable\n    match /site/{document=**} {\n      allow read: if true;\n      allow write: if isAdmin();\n    }\n\n    // Orders:\n    // - Admin can read/write all orders.\n    // - A user can only read their own orders.\n    // - A user cannot create/update/delete their own orders directly (this is handled by backend logic).\n    match /orders/{orderId} {\n      allow read: if isAdmin() || (request.auth != null && request.auth.uid == resource.data.userId);\n      allow write: if isAdmin();\n    }\n\n    // All other collections (characters, works, etc.): Publicly readable, admin writable\n    match /{collection}/{document=**} {\n        allow read: if true;\n        allow write: if isAdmin();\n    }\n  }\n}\n"}]}}
