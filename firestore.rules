rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Helper function to check for Admin role based on UID
    function isAdmin() {
      // Replace with the actual UID of your admin account in the new project.
      // You can find the UID in the Firebase Console -> Authentication -> Users tab.
      return request.auth.uid == "PLEASE_UPDATE_WITH_YOUR_ADMIN_UID";
    }

    // Site content is public readable, admin writable
    match /site/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Characters and related content are public readable, admin writable
    match /characterSeries/{seriesId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /characters/{characterId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Commissions and related content are public readable, admin writable
    match /commissionOptions/{optionId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /commissionStyles/{styleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Works are public readable, admin writable
    match /works/{workId} {
        allow read: if true;
        allow write: if isAdmin();
    }

    // Orders can only be read by the user who owns it or an admin.
    // Only admins can create, update, or delete orders.
    match /orders/{orderId} {
      allow read: if request.auth.uid == resource.data.userId || isAdmin();
      allow create, update, delete: if isAdmin();
    }
  }
}
