rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user is the designated admin
    function isAdmin(userId) {
      return userId == "s4uext3URcWMry52mRcPSeMhl0H2";
    }

    // Helper function to check if a user is the owner of a document
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    // Characters: Publicly readable, admin only write access
    match /characters/{characterId} {
      allow read: if true;
      allow write: if isAdmin(request.auth.uid);
    }
    
    // Character Series: Publicly readable, admin only write access
    match /characterSeries/{seriesId} {
        allow read: if true;
        allow write: if isAdmin(request.auth.uid);
    }

    // Commission Options: Publicly readable, admin only write access
    match /commissionOptions/{optionId} {
      allow read: if true;
      allow write: if isAdmin(request.auth.uid);
    }
    
    // Commission Styles: Publicly readable, admin only write access
    match /commissionStyles/{styleId} {
        allow read: if true;
        allow write: if isAdmin(request.auth.uid);
    }
    
    // Works: Publicly readable, admin only write access
    match /works/{workId} {
        allow read: if true;
        allow write: if isAdmin(request.auth.uid);
    }

    // Site Content: Publicly readable, admin only write access
    match /site/content {
      allow read: if true;
      allow write: if isAdmin(request.auth.uid);
    }

    // Orders: Users can read their own orders, admins can read all.
    // Users can create orders. Admins can update/delete any order.
    // Users can only update their own order if they are the owner.
    match /orders/{orderId} {
      allow read, update: if isOwner(resource.data.userId) || isAdmin(request.auth.uid);
      allow create: if request.auth != null; // Any authenticated user can create an order
      allow delete: if isAdmin(request.auth.uid);
    }
  }
}
