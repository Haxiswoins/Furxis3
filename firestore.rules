rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check for Admin UID
    function isAdmin() {
      // Use the unchanging UID for the most reliable admin check.
      return request.auth != null && request.auth.uid == 'jH8oPmt3a3bX7yGjZ2kC5sFvWqE2';
    }

    // Site content should be readable by anyone, writable only by admin
    match /site/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // All primary data collections are readable by anyone, writable only by admin
    match /{collection}/{docId} 
      where collection in ['characters', 'characterSeries', 'commissionOptions', 'commissionStyles', 'works'] {
        allow read: if true;
        allow write: if isAdmin();
    }

    // Orders can only be read by the user who owns it or an admin.
    // Only admins can create, update, or delete orders.
    match /orders/{orderId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == resource.data.userId);
      allow create, update, delete: if isAdmin();
    }
  }
}
