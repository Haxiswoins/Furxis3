
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the user is the designated admin
    function isAdmin() {
      return request.auth.uid == 's4uext3URcWMry52mRcPSeMhl0H2';
    }

    // Helper function to check if the user is the owner of the document
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Publicly readable collections, only writable by admin
    match /characters/{characterId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /characterSeries/{seriesId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /commissionOptions/{optionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /commissionStyles/{styleId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /works/{workId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Site content is publicly readable, only writable by admin
    match /site/content {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders can be created by any authenticated user.
    // They can only be read or updated by the owner or an admin.
    // Deletion is restricted to admin only.
    match /orders/{orderId} {
      allow create: if request.auth != null;
      allow read, update: if isOwner(resource.data.userId) || isAdmin();
      allow delete: if isAdmin();
    }
  }
}
