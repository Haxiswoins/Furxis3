
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the user is an admin
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'jH8oPmt3a3bX7yGjZ2kC5sFvWqE2';
    }

    // Site content: Publicly readable, admin writable
    match /site/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders:
    // - Admin can read/write all orders.
    // - A user can only read their own orders.
    // - A user cannot create/update/delete their own orders directly (this is handled by backend logic).
    match /orders/{orderId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == resource.data.userId);
      allow write: if isAdmin();
    }

    // All other collections (characters, works, etc.): Publicly readable, admin writable
    match /{collection}/{document=**} {
        allow read: if true;
        allow write: if isAdmin();
    }
  }
}
