
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
      // In a real app, use custom claims for roles.
      // For this project, we hardcode the admin's email.
      return request.auth.token.email == 'haxiswoins@qq.com';
    }

    // Publicly readable collections
    match /{collectionName}/{docId}
    where collectionName in ['characters', 'characterSeries', 'commissionOptions', 'commissionStyles', 'works', 'site'] {
      allow read: if true;
      allow write: if isAdmin(); // Only admin can write
    }

    // Orders can only be read by their owner or an admin.
    // New orders can be created by any signed-in user.
    match /orders/{orderId} {
      allow read, update: if isSignedIn() && (isOwner(resource.data.userId) || isAdmin());
      allow create: if isSignedIn();
      allow delete: if isAdmin();
    }
  }
}
