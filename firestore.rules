
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default-deny all reads and writes
    match /{document=**} {
      allow read, write: if false;
    }

    // Allow public read access to all collections
    // This is necessary for site content to be visible to all users.
    match /{collection}/{doc} {
      allow read: if true;
    }
    
    // Site content can only be written by an admin
    match /site/content {
      // Read is already covered by the public rule above
      allow write: if request.auth != null && request.auth.token.email == 'haxiswoins@qq.com';
    }

    // Orders have special, more secure rules
    match /orders/{orderId} {
      // Users can read their own orders, Admins can read any order.
      allow read: if request.auth != null && (request.auth.uid == resource.data.userId || request.auth.token.email == 'haxiswoins@qq.com');
      
      // Users can create their own orders.
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      
      // Only admins can update or delete orders.
      allow update, delete: if request.auth != null && request.auth.token.email == 'haxiswoins@qq.com';
    }

    // Any other write operations (characters, works, etc.) are restricted to admins.
    // This rule overrides the public read rule for write operations.
    match /{collection}/{docId} {
        // Read is allowed publicly from the rule above.
        // We only need to define specific write rules here.
        allow create, update, delete: if request.auth != null && request.auth.token.email == 'haxiswoins@qq.com';
    }
  }
}
